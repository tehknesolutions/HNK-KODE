{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hnk-kode/kodescript-binding.schema.json",
  "title": "HNK-KODESCRIPT Geometry-to-Language Binding",
  "type": "object",
  "required": ["bindingId", "glyphIdentity", "authority", "namespace", "linguisticBinding"],
  "properties": {
    "bindingId": {"type": "string", "minLength": 1},
    "glyphIdentity": {
      "type": "object",
      "required": ["n", "identityId", "path", "topologyValidation"],
      "properties": {
        "n": {"const": 12},
        "identityId": {"type": "string", "minLength": 1},
        "path": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(MF:L0[1-6]:S(?:0[1-9]|[1-6][0-9]|7[0-2])|CG:0[1-9]|CR:D:(?:0[1-9]|1[0-2]))$"
          }
        },
        "topologyValidation": {
          "type": "object",
          "required": ["validator", "status", "topologyVersion"],
          "properties": {
            "validator": {"const": "GFV-N12"},
            "status": {"const": "PASS"},
            "topologyVersion": {"type": "string", "minLength": 1},
            "featureVectorRef": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "featureVectorRef": {"type": "string"},
        "renderDistinctSpaceVersion": {"type": "string"}
      },
      "additionalProperties": false
    },
    "executionMetadata": {
      "type": "object",
      "properties": {
        "direction": {"enum": ["FORWARD", "REVERSE", "UNSPECIFIED"]},
        "profile": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "authority": {
      "enum": ["STRUCTURAL_ONLY", "HNK_CANDIDATE", "HUMAN_REVIEW", "HNK_CANON", "RESERVED"]
    },
    "namespace": {
      "enum": ["LANGUAGE", "SACRED", "GRAMMAR", "RUNTIME", "SYSTEM", "SW", "EXPERIMENTAL", "RESERVED"]
    },
    "linguisticBinding": {
      "type": "object",
      "properties": {
        "lexeme": {"type": ["string", "null"]},
        "phonologyRef": {"type": ["string", "null"]},
        "semanticRef": {"type": ["string", "null"]},
        "grammarRef": {"type": ["string", "null"]},
        "astRef": {"type": ["string", "null"]},
        "irRef": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {"type": "string"},
        "decision": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "acquisition": {
      "type": "object",
      "properties": {
        "level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"]},
        "isHeldOutForTransfer": {"type": "boolean"},
        "experimentIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"authority": {"enum": ["HNK_CANDIDATE", "HUMAN_REVIEW", "HNK_CANON"]}}, "required": ["authority"]},
      "then": {
        "properties": {
          "linguisticBinding": {
            "anyOf": [
              {"required": ["lexeme"], "properties": {"lexeme": {"type": "string", "minLength": 1}}},
              {"required": ["phonologyRef"], "properties": {"phonologyRef": {"type": "string", "minLength": 1}}},
              {"required": ["semanticRef"], "properties": {"semanticRef": {"type": "string", "minLength": 1}}},
              {"required": ["grammarRef"], "properties": {"grammarRef": {"type": "string", "minLength": 1}}},
              {"required": ["astRef"], "properties": {"astRef": {"type": "string", "minLength": 1}}},
              {"required": ["irRef"], "properties": {"irRef": {"type": "string", "minLength": 1}}}
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
