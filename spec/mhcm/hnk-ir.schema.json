{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hnk.dev/spec/mhcm/hnk-ir.schema.json",
  "title":"HNK-IR V0",
  "type":"object",
  "additionalProperties":false,
  "required":["version","world","instructions","provenance"],
  "properties":{
    "version":{"const":"0.1"},
    "world":{"type":"string","minLength":1},
    "instructions":{"type":"array","items":{"$ref":"#/$defs/instruction"}},
    "provenance":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}
  },
  "$defs":{
    "instruction":{"type":"object","additionalProperties":false,"required":["op","target"],"properties":{"op":{"enum":["ENTITY_DECLARE","PROPERTY_SET","EVENT_DECLARE","ACTION_CALL"]},"target":{"type":"string","minLength":1},"key":{"type":["string","null"]},"value":{},"args":{"type":"array","items":{}}}}
  }
}
