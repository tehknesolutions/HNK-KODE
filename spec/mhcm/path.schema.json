{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hnk.dev/spec/mhcm/path.schema.json",
  "title": "MHCM Path",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "addresses", "state"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "addresses": {"type": "array", "minItems": 1, "items": {"$ref": "address.schema.json"}},
    "edges": {"type": "array", "items": {"type": "string"}},
    "transform": {"type": ["string", "null"]},
    "state": {"enum": ["candidate", "validated", "canonical", "rejected", "unresolved"]},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
